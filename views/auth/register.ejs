<%- include('../partials/header') %>

<section class="form-section">
  <h2>Create your DevMatch account</h2>

  <% if (error) { %>
    <p class="error-msg"><%= error %></p>
  <% } %>

  <form action="/register" method="POST" id="registerForm">
    <label>Name</label>
    <input type="text" name="name" required>

    <label>Email</label>
    <input type="email" name="email" required>

    <label>Password</label>
    <input type="password" name="password" id="password" required>
    <p id="passwordHint" class="hint"></p>

    <label>Experience Level</label>
    <select name="experienceLevel">
      <option value="Beginner">Beginner</option>
      <option value="Intermediate">Intermediate</option>
      <option value="Advanced">Advanced</option>
    </select>

    <label>Bio</label>
    <textarea name="bio"></textarea>

    <label>Skills (comma-separated)</label>
    <input type="text" name="skills" placeholder="JavaScript, React, Node.js">

    <label>Interests</label>
    <input type="text" name="interests" placeholder="Hackathons, Open Source">

    <label>Availability</label>
    <input type="text" name="availability" placeholder="Weekends, 5 hrs/week">

    <label>GitHub URL</label>
    <input type="url" name="githubUrl">

    <label>Portfolio URL</label>
    <input type="url" name="portfolioUrl">

    <button type="submit">Register</button>
  </form>
</section>

<script src="/js/validation.js"></script>

<%- include('../partials/footer') %>