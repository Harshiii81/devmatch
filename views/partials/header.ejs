<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DevMatch</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark devmatch-navbar">
    <div class="container">
      <a class="navbar-brand" href="/">DevMatch</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/projects">Browse Projects</a></li>
          <li class="nav-item"><a class="nav-link" href="/projects/live-search">Live Search</a></li>
          <% if (typeof userLoggedIn !== 'undefined' && userLoggedIn) { %>
            <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/profile">Profile</a></li>
            <li class="nav-item"><a class="nav-link" href="/projects/create">Create Project</a></li>
            <li class="nav-item">
              <a class="nav-link" href="/notifications">
                🔔<% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                  <span class="badge bg-danger"><%= unreadCount %></span>
                <% } %>
              </a>
            </li>
            <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/register">Register</a></li>
            <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
  <main class="container py-4">