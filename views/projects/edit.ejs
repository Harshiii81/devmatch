<%- include('../partials/header') %>

<section class="form-section">
  <h2>Edit Project</h2>

  <% if (error) { %>
    <p class="error-msg"><%= error %></p>
  <% } %>

  <form action="/projects/<%= project.id %>/edit" method="POST">
    <label>Project Title</label>
    <input type="text" name="title" value="<%= project.title %>" required>

    <label>Description</label>
    <textarea name="description" required><%= project.description %></textarea>

    <label>Required Skills (comma-separated)</label>
    <input type="text" name="requiredSkills" value="<%= project.required_skills || '' %>">

    <label>Team Size (max members)</label>
    <input type="number" name="teamSize" min="1" value="<%= project.team_size %>" required>

    <label>Duration</label>
    <input type="text" name="duration" value="<%= project.duration || '' %>">

    <label>Project Type</label>
    <select name="projectType">
      <option value="Hackathon" <%= project.project_type === 'Hackathon' ? 'selected' : '' %>>Hackathon</option>
      <option value="Open Source" <%= project.project_type === 'Open Source' ? 'selected' : '' %>>Open Source</option>
      <option value="Startup Idea" <%= project.project_type === 'Startup Idea' ? 'selected' : '' %>>Startup Idea</option>
      <option value="Learning Project" <%= project.project_type === 'Learning Project' ? 'selected' : '' %>>Learning Project</option>
    </select>

    <label>Commitment / Availability Needed</label>
    <input type="text" name="commitment" value="<%= project.commitment || '' %>">

    <button type="submit">Save Changes</button>
  </form>

  <form action="/projects/<%= project.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this project? This cannot be undone.');" style="margin-top:1rem;">
    <button type="submit" style="background:#b91c1c;">Delete Project</button>
  </form>

  <p><a href="/projects/<%= project.id %>">Cancel</a></p>
</section>

<%- include('../partials/footer') %>